<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The OS is in dark mode, but the app itself is light-only: MaterialApp
         is built with one `theme` and no `darkTheme`. Mirroring the light
         window here keeps a dark-mode device from flashing a black window
         with white status bar icons a moment before the light UI lands. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
